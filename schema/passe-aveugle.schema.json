{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thomas-pns/VeriTrace/schema/passe-aveugle.schema.json",
  "title": "Résultat d'une contre-vérification à l'aveugle",
  "description": "Produit par le sous-agent du skill contre-verifier, qui n'a vu que l'affirmation. Voir .claude/skills/contre-verifier/SKILL.md.",
  "type": "object",
  "required": ["type", "points", "meilleure_preuve_contraire", "sources", "date"],
  "properties": {
    "type": { "enum": ["verification", "debat"] },
    "affirmation": { "type": "string", "minLength": 10 },
    "question": { "type": "string", "minLength": 10 },
    "statut": { "enum": ["etabli", "faux", "trompeur", "non_prouve", "conteste"] },
    "confiance": { "enum": ["haute", "moyenne", "faible"] },
    "points": {
      "description": "verification : etabli, faux, inconnu, rumeur. debat : positions, chiffrages, accords, desaccords. Chaque point est une phrase courte, avec ses sources [S1].",
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "meilleure_preuve_contraire": {
      "description": "La meilleure preuve trouvée contre la conclusion de cette passe, et pourquoi elle est ou n'est pas retenue.",
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "type", "extrait"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[1-9]\\d*$" },
          "url": { "type": "string", "pattern": "^https?://\\S+$" },
          "archive": { "type": "string" },
          "type": { "enum": ["primaire", "institutionnelle", "etude", "presse", "reseau_social"] },
          "extrait": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "additionalProperties": false
      }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "verification" } } },
      "then": { "required": ["affirmation", "statut", "confiance"] }
    },
    {
      "if": { "properties": { "type": { "const": "debat" } } },
      "then": { "required": ["question"], "not": { "anyOf": [{ "required": ["statut"] }, { "required": ["confiance"] }] } }
    }
  ]
}
