---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { lien, sujetLisible } from "../../lib/libelles";

const fiches = await getCollection("fiches");
const compte = new Map<string, number>();
for (const f of fiches) for (const s of f.data.sujets) compte.set(s, (compte.get(s) ?? 0) + 1);
const sujets = [...compte].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "fr"));
---
<Base titre="Sujets" page="sujets" description="Toutes les fiches VeriTrace, regroupées par sujet.">
  <h1>Sujets</h1>
  <p class="chapeau">Les fiches regroupées par thème. Une fiche peut appartenir à plusieurs sujets.</p>
  {sujets.length
    ? <ul class="sujets">
        {sujets.map(([s, n]) => <li><a class="etiquette" href={lien(`sujets/${s}/`)}>{sujetLisible(s)} · {n}</a></li>)}
      </ul>
    : <p class="vide">Aucun sujet pour l'instant.</p>}
</Base>
